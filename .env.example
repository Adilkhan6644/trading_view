# =========================
# Core runtime
# =========================
EXCHANGE_ID=binance
MARKET_TYPE=futures
API_KEY=
API_SECRET=
API_PASSWORD=
USE_TESTNET=false
SCAN_INTERVAL_SECONDS=20
OHLCV_LIMIT=250
MAX_CONCURRENT_REQUESTS=5
RETRY_ATTEMPTS=4
RETRY_BACKOFF_SECONDS=1.2
LOG_LEVEL=INFO
TIMEZONE=UTC

# =========================
# Watchlist and timeframes
# =========================
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAMES=1m,3m,5m
SESSION_FILTER_ENABLED=true
SESSIONS=LONDON,NEW_YORK

# =========================
# Strategy settings
# =========================
EMA_FAST=8
EMA_MID=21
EMA_SLOW=55
ATR_LENGTH=14
VOLUME_AVG_LENGTH=20
MOMENTUM_MIN_PCT=0.03
COOLDOWN_MINUTES=8

# =========================
# Risk settings
# STOP_LOSS_MODE = atr | percent
# =========================
STOP_LOSS_MODE=atr
STOP_LOSS_ATR_MULTIPLIER=1.0
STOP_LOSS_PERCENT=0.5
RISK_REWARD_RATIO=3.0

# =========================
# Telegram
# =========================
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =========================
# Email (Gmail SMTP)
# =========================
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_APP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# =========================
# Optional modes
# =========================
MODE=live
PAPER_TRADING_ENABLED=false
BACKTEST_ENABLED=false
BACKTEST_LOOKBACK_CANDLES=1200
