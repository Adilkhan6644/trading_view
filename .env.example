# =========================
# Core runtime
# =========================
EXCHANGE_ID=binance
MARKET_TYPE=futures
API_KEY=
API_SECRET=
# NOT used for Binance. Leave empty. Only for exchanges like OKX/KuCoin (API passphrase).
API_PASSWORD=
USE_TESTNET=false
SCAN_INTERVAL_SECONDS=20
OHLCV_LIMIT=250
MAX_CONCURRENT_REQUESTS=5
RETRY_ATTEMPTS=4
RETRY_BACKOFF_SECONDS=1.2
LOG_LEVEL=INFO
TIMEZONE=UTC

# =========================
# Watchlist and timeframes
# =========================
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAMES=5m
SESSION_FILTER_ENABLED=true
SESSIONS=LONDON,NEW_YORK

# =========================
# Strategy settings
# =========================
EMA_FAST=8
EMA_MID=21
EMA_SLOW=55
ATR_LENGTH=14
VOLUME_AVG_LENGTH=20
MOMENTUM_MIN_PCT=0.03
COOLDOWN_MINUTES=8
SIDEWAYS_FILTER_ENABLED=true
ADX_LENGTH=14
ADX_TREND_MIN=22
SIDEWAYS_EMA_SPREAD_MAX_PCT=0.2

# =========================
# Risk settings
# STOP_LOSS_MODE = atr | percent
# =========================
STOP_LOSS_MODE=atr
STOP_LOSS_ATR_MULTIPLIER=1.0
STOP_LOSS_PERCENT=0.5
RISK_REWARD_RATIO=3.0

# =========================
# Telegram
# =========================
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =========================
# Discord (no Gmail / no 2FA — recommended if no Telegram)
# =========================
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=

# =========================
# ntfy push (phone app — no Gmail / no 2FA)
# https://ntfy.sh — subscribe to NTFY_TOPIC in the app
# =========================
NTFY_ENABLED=false
NTFY_TOPIC=
NTFY_SERVER_URL=https://ntfy.sh

# =========================
# Email (Gmail SMTP — requires Gmail 2-Step Verification)
# =========================
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_APP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# =========================
# Dashboard (FastAPI)
# =========================
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
AUTO_START_BOT=false

# Data feed: websocket (live, default) | rest (poll every SCAN_INTERVAL_SECONDS)
DATA_MODE=websocket
# Binance WS: auto | spot | futures (use spot if futures stream has no data)
BINANCE_WS_MARKET=auto
# Alerts only when a candle closes (recommended). Live ticks still update dashboard.
ALERT_ON_CANDLE_CLOSE_ONLY=true

# =========================
# Optional modes
# =========================
MODE=live
PAPER_TRADING_ENABLED=false
BACKTEST_ENABLED=false
BACKTEST_LOOKBACK_CANDLES=1200
